    "db:demo": "tsx seed/run-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "@types/qrcode": "^1.5.6",
    "@vyuha/shared": "workspace:*",
    "bullmq": "^6.1.0",
    "cron-parser": "5.8.1",
    "drizzle-orm": "^0.45.2",
